---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = '这个地址没有对应页面。';
---

<BaseLayout title="未找到页面 · 医疗 AI 与 DRG/DIP 工具目录" description={description}>
  <section class="not-found">
    <p class="kicker">404</p>
    <h1>未找到页面</h1>
    <p>这个地址没有对应的目录、周报或说明。</p>
    <p><a href="/">返回目录</a></p>
  </section>
</BaseLayout>

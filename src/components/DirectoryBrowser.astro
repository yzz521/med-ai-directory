---
import type { CollectionEntry } from 'astro:content';
import InlineText from './InlineText.astro';
import { entryTags } from '../lib/entries';
import { plainText } from '../lib/text';

interface Props {
  entries: CollectionEntry<'entries'>[];
}

const { entries } = Astro.props;

const items = entries.map((entry) => {
  const data = entry.data;
  const tags = entryTags(data);
  return {
    ...data,
    tags,
    search: plainText(`${data.name} ${data.summary} ${data.category} ${data.region_or_version}`).toLowerCase(),
  };
});

const categories = [...new Set(items.map((item) => item.category))];
const tagOrder = ['官方', '第三方', '开源', '商业'];
const tags = tagOrder.filter((tag) => items.some((item) => item.tags.includes(tag)));

function categoryCount(category: string): number {
  return items.filter((item) => item.category === category).length;
}

function tagCount(tag: string): number {
  return items.filter((item) => item.tags.includes(tag)).length;
}
---

<div class="browser" id="directory">
  <div class="filters">
    <label class="field">
      <span>搜索</span>
      <input type="search" data-search-input placeholder="名称、简介或版本" autocomplete="off" />
    </label>

    <div>
      <p class="filter-label" id="category-label">类别</p>
      <div class="filter-list" role="group" aria-labelledby="category-label">
        <button type="button" data-filter="category" data-value="all" aria-pressed="true">
          全部 <span>{items.length}</span>
        </button>
        {
          categories.map((category) => (
            <button type="button" data-filter="category" data-value={category} aria-pressed="false">
              {category} <span>{categoryCount(category)}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div>
      <p class="filter-label" id="tag-label">标签</p>
      <div class="tag-row" role="group" aria-labelledby="tag-label">
        <button type="button" data-filter="tag" data-value="all" aria-pressed="true">全部</button>
        {
          tags.map((tag) => (
            <button type="button" data-filter="tag" data-value={tag} aria-pressed="false">
              {tag} <span>{tagCount(tag)}</span>
            </button>
          ))
        }
      </div>
      <p class="hint">「官方 / 第三方」来自条目的 official 字段。「开源」「商业」只在类别原文已经包含这些词时出现。</p>
    </div>

    <button type="button" class="clear" data-clear hidden>清除筛选</button>
    <noscript>
      <p class="noscript-note">未启用 JavaScript 时仍列出全部条目，筛选不可用。</p>
    </noscript>
  </div>

  <div>
    <p class="count" aria-live="polite">显示 <span data-count>{items.length}</span> 条</p>
    <div class="cards">
      {
        items.map((item) => (
          <article
            class="card"
            data-entry
            data-category={item.category}
            data-tags={item.tags.join('|')}
            data-search={item.search}
          >
            <a class="card-link" href={`/entries/${item.slug}/`}>
              <div class="card-top">
                <span class="num">#{item.id}</span>
                <span class:list={['badge', item.official ? 'is-official' : 'is-third']}>
                  {item.official ? '官方' : '第三方'}
                </span>
              </div>
              <h2>{item.name}</h2>
              <p class="summary">
                <InlineText text={item.summary} />
              </p>
              <p class="meta">{item.category}</p>
              <p class="region">{item.region_or_version}</p>
              {item.verified_date && (
                <p class="verified">
                  <span>最后核实日期</span>
                  {item.verified_date}
                </p>
              )}
            </a>
          </article>
        ))
      }
    </div>
    <p class="empty" data-empty hidden>没有符合筛选条件的条目。</p>
  </div>
</div>

<script>
  const root = document.querySelector('#directory');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-entry]')];
    const categoryButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter="category"]')];
    const tagButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter="tag"]')];
    const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const emptyEl = root.querySelector<HTMLElement>('[data-empty]');
    const clearButton = root.querySelector<HTMLButtonElement>('[data-clear]');

    const params = new URLSearchParams(location.search);
    let category = params.get('category') || 'all';
    let tag = params.get('tag') || 'all';
    let query = params.get('q') || '';

    if (searchInput) searchInput.value = query;

    function syncButtons(): void {
      for (const button of categoryButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.value === category));
      }
      for (const button of tagButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.value === tag));
      }
      if (clearButton) {
        clearButton.hidden = category === 'all' && tag === 'all' && query.trim() === '';
      }
    }

    function apply(): void {
      const needle = query.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const tags = (card.dataset.tags ?? '').split('|').filter(Boolean);
        const haystack = card.dataset.search ?? '';
        const matches =
          (category === 'all' || card.dataset.category === category) &&
          (tag === 'all' || tags.includes(tag)) &&
          (needle === '' || haystack.includes(needle));
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (countEl) countEl.textContent = String(visible);
      if (emptyEl) emptyEl.hidden = visible !== 0;
      syncButtons();
    }

    function writeUrl(): void {
      const next = new URLSearchParams();
      if (category !== 'all') next.set('category', category);
      if (tag !== 'all') next.set('tag', tag);
      if (query.trim() !== '') next.set('q', query.trim());
      const search = next.toString();
      const url = search ? `${location.pathname}?${search}` : location.pathname;
      history.replaceState(null, '', url);
    }

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const filter = target.closest<HTMLButtonElement>('[data-filter]');
      if (filter && root.contains(filter)) {
        const value = filter.dataset.value || 'all';
        if (filter.dataset.filter === 'category') category = value;
        if (filter.dataset.filter === 'tag') tag = value;
        apply();
        writeUrl();
        return;
      }
      if (target.closest('[data-clear]')) {
        category = 'all';
        tag = 'all';
        query = '';
        if (searchInput) searchInput.value = '';
        apply();
        writeUrl();
      }
    });

    searchInput?.addEventListener('input', () => {
      query = searchInput.value;
      apply();
      writeUrl();
    });

    apply();
  }
</script>
